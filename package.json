{
  "name": "@draggable/storeshot-sdk",
  "version": "2.55.0",
  "description": "Official TypeScript/JavaScript SDK for the Storeshot API: App Store and Google Play marketing screenshots from raw app screenshots.",
  "keywords": [
    "storeshot",
    "app store",
    "google play",
    "screenshots",
    "sdk",
    "api"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Draggable/storeshot-sdk.git"
  },
  "homepage": "https://storeshot.art/docs/",
  "bugs": {
    "email": "support@storeshot.art"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "node scripts/prepublish-guard.mjs"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "esbuild": "0.27.7",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
